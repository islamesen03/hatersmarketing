# Kopyalayın: .env.local (yerel) veya barındırma panelindeki ortam değişkenleri.
# Gerçek anahtarları ASLA repoya eklemeyin.

# --- Site ---
# Canlı alan adı (sonunda / olmadan). Canonical, sitemap, OG ve JSON-LD bunu kullanır.
NEXT_PUBLIC_SITE_URL=https://alanadi.com
# Lansman onayı verilene kadar false bırakın: robots.txt ve meta robots aramayı kapatır.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Form teslimatı (en az birini yapılandırın; yoksa form "gönderilmedi" der) ---
# 1) CRM / otomasyon webhook'u (HubSpot, Make, Zapier, n8n ...). JSON POST alır.
LEAD_WEBHOOK_URL=
# İsteğe bağlı; webhook'a X-Webhook-Secret başlığıyla gönderilir.
LEAD_WEBHOOK_SECRET=

# 2) Resend ile e-posta (https://resend.com). Gönderen alan adı Resend'de doğrulanmış olmalı.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM="Haters Marketing <form@alanadi.com>"

# --- Analitik (isteğe bağlı) ---
# Tanımlanırsa çerez bannerı görünür; GA4 yalnızca ziyaretçi onay verince yüklenir.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
